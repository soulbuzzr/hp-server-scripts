Service running at /etc/systemd/system/immich-tunnel.service
[Unit]
Description=Immich Cloudflare quick tunnel (weekly rotation)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://localhost:2283
Restart=always
RestartSec=10
# with -, same failing command, unit stays fine:
ExecStartPost=-/home/hpserver/System_Scripts/Immich/maintenance/immich-tunnel-notify.sh
User=hpserver
Group=hpserver

[Install]
WantedBy=multi-user.target


Add timers to the service:

root@hpelitebook8460p:~# cat /etc/systemd/system/immich-tunnel-restart.service
[Unit]
Description=Restart Immich tunnel (weekly rotation trigger)

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart immich-tunnel.service

root@hpelitebook8460p:~# cat /etc/systemd/system/immich-tunnel-restart.timer
[Unit]
Description=Rotate Immich tunnel every Wednesday 3AM

[Timer]
OnCalendar=Wed *-*-* 03:00:00
Persistent=true

[Install]
WantedBy=timers.target

