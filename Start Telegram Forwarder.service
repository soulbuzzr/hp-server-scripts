Service running at /etc/systemd/system/tg-forward.service
[Unit]
Description=Telegram Forwarder Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hpserver
WorkingDirectory=/home/hpserver/System_Scripts
ExecStart=/home/hpserver/System_Scripts/.venv/bin/python /home/hpserver/System_Scripts/tg_forwarder.py
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target