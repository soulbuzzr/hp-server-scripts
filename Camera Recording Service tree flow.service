The below shows the order of camera recording services:

# /etc/systemd/system/camera.target
[Unit]
Description=Unified Camera Recording Pipeline
After=network-online.target
Wants=network-online.target
Requires=camera-tree.service

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/camera-tree.service
[Unit]
Description=Camera Directory Tree Service
After=start-ramdisk.service
Requires=start-ramdisk.service
PartOf=camera.target

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/lib/camera_tree_daemon.sh
Restart=always
RestartSec=5

[Install]
WantedBy=camera.target

# /etc/systemd/system/camera-main-recorder.service
[Unit]
Description=Main Camera Recorder
After=camera-tree.service
Requires=camera-tree.service
BindsTo=camera-tree.service
PartOf=camera-tree.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/main_camera_recorder.sh
Restart=always
RestartSec=5

[Install]
WantedBy=camera-tree.service

# /etc/systemd/system/camera-mini-recorder.service
[Unit]
Description=Mini Camera Recorder
After=camera-tree.service
Requires=camera-tree.service
BindsTo=camera-tree.service
PartOf=camera-tree.service


[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/mini_camera_recorder.sh
Restart=always
RestartSec=5

[Install]
WantedBy=camera-tree.service

# /etc/systemd/system/camera-upload-main.service
[Unit]
Description=Main Camera Upload Service

Wants=network-online.target
After=network-online.target camera-main-recorder.service
BindsTo=camera-main-recorder.service
PartOf=camera-tree.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/upload_camera_recordings.>
Restart=always
RestartSec=10

[Install]
WantedBy=camera-tree.service

# /etc/systemd/system/camera-upload-mini.service
[Unit]
Description=Mini Camera Upload Service

Wants=network-online.target
After=network-online.target camera-mini-recorder.service
BindsTo=camera-mini-recorder.service
PartOf=camera-tree.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/upload_camera_recordings.>
Restart=always
RestartSec=10

[Install]
WantedBy=camera-tree.service

# /etc/systemd/system/camera-archive.service
[Unit]
Description=Camera Archive Service

Wants=camera-upload-main.service
Wants=camera-upload-mini.service

After=camera-upload-main.service
After=camera-upload-mini.service

PartOf=camera-tree.service

RequiresMountsFor=/mnt/camera

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/archive_to_hdd.sh
Restart=always
RestartSec=10

[Install]
WantedBy=camera-tree.service 

# /etc/systemd/system/camera-cleanup.service
[Unit]
Description=Camera Cleanup Service
After=camera-archive.service
BindsTo=camera-archive.service
PartOf=camera-archive.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/cleanup_uploaded_recordin>
Restart=always
RestartSec=20

[Install]
WantedBy=camera-tree.service

# /etc/systemd/system/camera-retention.service
[Unit]
Description=Camera Archive Retention Service
After=camera-archive.service
BindsTo=camera-archive.service
PartOf=camera-archive.service

RequiresMountsFor=/mnt/camera

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/hpserver/System_Scripts/Camera_Recording/telegram/archive_retention_cleanup>
Restart=always
RestartSec=60

[Install]
WantedBy=camera-archive.service



ENABLE ALL AT ONCE:
sudo systemctl daemon-reload && \
sudo systemctl enable camera.target && \
sudo systemctl enable camera-tree.service && \
sudo systemctl enable camera-main-recorder.service && \
sudo systemctl enable camera-mini-recorder.service && \
sudo systemctl enable camera-upload-main.service && \
sudo systemctl enable camera-upload-mini.service && \
sudo systemctl enable camera-archive.service && \
sudo systemctl enable camera-cleanup.service && \
sudo systemctl enable camera-retention.service

